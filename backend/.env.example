# Copie este archivo como .env y ajuste los valores.
LAB_ENTORNO=desarrollo

# SQLite para desarrollar sin Docker (se crea el archivo laboratorio.db):
LAB_DATABASE_URL=sqlite:///./laboratorio.db
# PostgreSQL (docker compose o servidor del laboratorio):
# LAB_DATABASE_URL=postgresql+psycopg://lab:lab_dev@localhost:5432/laboratorio

# Genere uno propio con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
LAB_JWT_SECRETO=cambie-este-valor-por-uno-largo-y-aleatorio
LAB_TOKEN_MINUTOS=120

LAB_CORS_ORIGENES=["http://localhost:5173","http://127.0.0.1:5173"]
LAB_ZONA_HORARIA=America/Bogota
LAB_DIAS_MAX_PRESTAMO=15
